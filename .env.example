# Database connection string for Prisma / application
# Example: postgresql://USER:PASSWORD@localhost:5432/DATABASE?schema=public
DATABASE_URL=postgresql://dalt:daltpass@127.0.0.1:5432/dalt_db?schema=public

# Postgres runtime variables used by docker-compose.db.yml
POSTGRES_USER=dalt
POSTGRES_PASSWORD=daltpass
POSTGRES_DB=dalt_db
