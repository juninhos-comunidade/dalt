FROM node:22-alpine

RUN apk add --no-cache openssl libc6-compat
RUN npm i -g pnpm

WORKDIR /app

# Em ambiente de desenvolvimento, não copiamos os arquivos no Dockerfile.
# O diretório do host será montado como volume via docker-compose.dev.yml.
# O comando de inicialização também será injetado pelo compose (pnpm install && pnpm dev).
