{
  "name": "@dalt/api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema prisma/schema.prisma --name init",
    "prisma:dbpush": "prisma db push --schema prisma/schema.prisma"
  },
  "dependencies": {
    "@dalt/shared-types": "workspace:*",
    "fastify": "^4.26.2"
  },
  "devDependencies": {
    "@types/node": "^20",
    "tsx": "^4.7.1",
    "typescript": "^5",
    "prisma": "^5.10.0"
  }
}
